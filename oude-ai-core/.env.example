# Variáveis GLOBAIS do servidor. Em produção ficam no painel de variáveis do Render (nunca no código, nunca em
# prompt de IA). As chaves dos LOJISTAS (IA, WhatsApp, pagamentos, fornecedor) NÃO ficam aqui: ficam cifradas no
# Supabase, em org_integrations, isoladas por org_id.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Segredo compartilhado com o backend do OÚDE CRM, que assina os tokens (>= 32 caracteres).
CRM_SHARED_SECRET=
# Chave mestra Fernet (gere com: python -m app.core.crypto gerar-chave). Trocar = rotação (ver README).
CREDENTIALS_MASTER_KEY=
# URL https pública deste serviço (usada nos webhooks de pagamento).
PUBLIC_BASE_URL=https://oude-ai-core.onrender.com
# Rotação (opcional): valores antigos aceitos só para verificar/decifrar.
CRM_SHARED_SECRET_PREVIOUS=
CREDENTIALS_MASTER_KEY_PREVIOUS=
# Opcional: habilita /v1/internal/* (operacional; não dá acesso a dados de organização).
INTERNAL_API_TOKEN=
ENVIRONMENT=production
LOG_LEVEL=INFO
RUN_SCHEDULER=true
MAX_CONCURRENT_TENANTS=20
HTTP_TIMEOUT_SECONDS=20
TOKEN_TTL_MAX_SECONDS=120
CHAT_REQUESTS_PER_MINUTE=20
